#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    # Em contêineres e em instalações sem udev ou systemd, estes passos não se aplicam.
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules || true
        udevadm trigger --subsystem-match=usb --attr-match=idVendor=096e || true
    fi
    if [ -d /run/systemd/system ]; then
        systemctl enable --now pcscd.socket || true
        systemctl restart pcscd || true
    fi
    echo "Assinador de PDF instalado. Retire o token, conecte de novo e abra o programa pelo menu."
fi

exit 0
